meta {
  name: 15 CT-022 valor por unidade negativo
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/colaboradores
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  matricula: BR022
  nome: Unid Neg
  salarioBase: 1000
  tipo: PRODUCAO
  quantidadeProduzida: 1
  valorPorUnidade: -2
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("formulário devolvido com erros", function() {
    expect(String(res.getBody())).to.include("Confira os campos destacados");
  });
  test("corpo contém \"O valor por unidade não pode ser negativo.\"", function() {
    expect(String(res.getBody())).to.include("O valor por unidade não pode ser negativo.");
  });
}
