meta {
  name: 06 CT-010 matricula com pontuacao
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/colaboradores
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  matricula: BR-010
  nome: Pontuacao
  salarioBase: 1000
  tipo: PADRAO
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("formulário devolvido com erros", function() {
    expect(String(res.getBody())).to.include("Confira os campos destacados");
  });
  test("corpo contém \"A matrícula deve conter apenas letras sem acento e números.\"", function() {
    expect(String(res.getBody())).to.include("A matrícula deve conter apenas letras sem acento e números.");
  });
}
