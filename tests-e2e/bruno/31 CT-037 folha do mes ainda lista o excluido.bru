meta {
  name: 31 CT-037 folha do mes ainda lista o excluido
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/folha?mes={{mes}}&ano={{ano}}
  body: none
  auth: none
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("corpo contém \"BR004\"", function() {
    expect(String(res.getBody())).to.include("BR004");
  });
  test("corpo contém \"4 colaboradores\"", function() {
    expect(String(res.getBody())).to.include("4 colaboradores");
  });
  test("total do mês continua R$ 9.100,00", function() {
    expect(String(res.getBody())).to.match(/R\$\s*9\.100,00/);
  });
}
