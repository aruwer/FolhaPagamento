meta {
  name: 09 CT-013 salario em branco
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/colaboradores
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  matricula: BR013
  nome: Sem Salario
  salarioBase: 
  tipo: PADRAO
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("formulário devolvido com erros", function() {
    expect(String(res.getBody())).to.include("Confira os campos destacados");
  });
  test("corpo contém \"Informe o salário base.\"", function() {
    expect(String(res.getBody())).to.include("Informe o salário base.");
  });
}
