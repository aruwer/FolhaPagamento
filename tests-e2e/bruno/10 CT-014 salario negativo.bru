meta {
  name: 10 CT-014 salario negativo
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/colaboradores
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  matricula: BR014
  nome: Negativo
  salarioBase: -1
  tipo: PADRAO
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("formulário devolvido com erros", function() {
    expect(String(res.getBody())).to.include("Confira os campos destacados");
  });
  test("corpo contém \"O salário base não pode ser negativo.\"", function() {
    expect(String(res.getBody())).to.include("O salário base não pode ser negativo.");
  });
}
