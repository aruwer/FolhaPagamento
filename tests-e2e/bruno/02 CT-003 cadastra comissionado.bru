meta {
  name: 02 CT-003 cadastra comissionado
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/colaboradores
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  matricula: BR002
  nome: Bruno Comissao
  salarioBase: 2000
  tipo: COMISSIONADO
  valorVendas: 10000
  percentualComissao: 5
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("cadastro aceito (sem erros de formulário)", function() {
    expect(String(res.getBody())).to.not.include("Confira os campos destacados");
  });
}
