meta {
  name: 08 CT-012 nome em branco
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/colaboradores
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  matricula: BR012
  nome: 
  salarioBase: 1000
  tipo: PADRAO
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("formulário devolvido com erros", function() {
    expect(String(res.getBody())).to.include("Confira os campos destacados");
  });
  test("corpo contém \"Informe o nome.\"", function() {
    expect(String(res.getBody())).to.include("Informe o nome.");
  });
}
