meta {
  name: 05 CT-009 matricula duplicada
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/colaboradores
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  matricula: BR001
  nome: Duplicada
  salarioBase: 1000
  tipo: PADRAO
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("formulário devolvido com erros", function() {
    expect(String(res.getBody())).to.include("Confira os campos destacados");
  });
  test("corpo contém \"Já existe colaborador com essa matrícula.\"", function() {
    expect(String(res.getBody())).to.include("Já existe colaborador com essa matrícula.");
  });
}
